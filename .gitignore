# Vignette and knitr residue from building in place (R CMD build output is
# already covered by /doc/ and /Meta/). Keeps the test-all.slurm dirty guard
# from tripping on ordinary local iteration.
vignettes/*.html
vignettes/*.pdf
*_cache/
*.knit.md
*.utf8.md
.Renviron

# testthat writes a reprex here for each failing expectation under R CMD check
# (testthat >= 3.3.0). Generated output, never an input: no test reads it.
tests/testthat/_problems/

# pkgdown site
docs/
